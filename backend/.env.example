# ==========================================
# FleetGuard Backend Environment Configuration
# ==========================================

PORT=5000
DATABASE_URL="file:./dev.db"

# Security Secrets (replace with high-entropy keys in production)
JWT_SECRET=replace_with_a_secure_jwt_random_secret_string
DEVICE_AUTH_SECRET=fleetguard_device_shared_secret_token_2026

# Telegram Bot Integration (Optional - notifications logged locally if blank)
# Obtain token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
# Obtain your chat or group ID from @userinfobot or Telegram API
TELEGRAM_CHAT_ID=

# Server-Side Google Maps API Key (Optional for geocoding address -> lat/lng)
GOOGLE_MAPS_SERVER_API_KEY=

# IoT Engine Thresholds
HEARTBEAT_TIMEOUT_SECONDS=60
GPS_MAX_VALID_SPEED_KMH=200
GPS_MAX_DISTANCE_JUMP_KM=5
SPEED_ALERT_COOLDOWN_SECONDS=120
